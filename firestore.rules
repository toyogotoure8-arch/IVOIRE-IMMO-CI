rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ('roles' in getUserData()) && ('admin' in getUserData().roles)) ||
        request.auth.token.email == 'toyogotoure8@gmail.com'
      );
    }

    function isProprietaire() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ('roles' in getUserData()) && ('proprietaire' in getUserData().roles))
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Any user can read public profile fields; owner or admin can access full profile
      allow read: if true;
      
      // User can create their unique profile (cannot add 'admin' role unless admin)
      allow create: if isOwner(userId) && 
        (!('admin' in request.resource.data.roles) || isAdmin());

      // User can update their own profile (cannot grant 'admin' or alter 'bloque' unless admin)
      allow update: if (isOwner(userId) || isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bloque']))) &&
        (
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bloque']) ||
          (!('admin' in request.resource.data.roles) || ('roles' in resource.data && 'admin' in resource.data.roles))
        );

      allow delete: if isAdmin();
    }

    // LISTINGS COLLECTION
    match /listings/{listingId} {
      // Published listings are readable by EVERYONE, even unauthenticated
      // Draft/pending listings are readable by owner or admin
      allow read: if resource == null || 
        resource.data.statut == 'publiee' || 
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin()));

      // Create: Only users with 'proprietaire' or 'admin' role can create listings
      allow create: if isSignedIn() && isProprietaire() && 
        (request.resource.data.ownerId == request.auth.uid || isAdmin()) &&
        (request.resource.data.statut != 'publiee' || isAdmin()) &&
        (request.resource.data.ownerVerifie != true || isAdmin());

      // Update: Owner can update their listing
      allow update: if (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin())) &&
        (
          isAdmin() ||
          (
            (request.resource.data.statut != 'publiee') &&
            (!('ownerVerifie' in request.resource.data) || request.resource.data.ownerVerifie == resource.data.ownerVerifie)
          )
        );

      // Delete: Owner or Admin
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // BOOKINGS COLLECTION
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // FAVORITES COLLECTION
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ALERTS COLLECTION
    match /alerts/{alertId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // REPORTS COLLECTION
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // MESSAGES COLLECTION
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
