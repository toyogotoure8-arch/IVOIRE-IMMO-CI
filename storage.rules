rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Anyone can read photos/files
      allow read: if true;
      
      // Only authenticated users can upload photos, limited to max 5MB and image content-type
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
                   
      allow delete: if request.auth != null;
    }
  }
}
